{
  "name": "figma-reader",
  "version": "0.2.1",
  "description": "CLI tool for reading Figma design data",
  "type": "module",
  "bin": {
    "figma-reader": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "figma",
    "cli",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mach3/figma-reader-cli.git"
  },
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "citty": "^0.2.1",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.3.5",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
